<UserControl x:Class="SISapi_Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="850"
             Background="#F8FAFC"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,25">
            <StackPanel>
                <TextBlock Text="Selamat Datang Kembali!" FontSize="26" FontWeight="Bold" Foreground="#1E3259"/>
                <TextBlock Text="Berikut adalah ringkasan populasi ternak, fasilitas, dan jadwal vaksinasi." FontSize="13" Foreground="#334155" FontWeight="Medium" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Ringkasan Card -->
        <Grid Grid.Row="1" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Sapi -->
            <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="18" BorderBrush="#CBD5E1" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" Direction="270" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="TOTAL SAPI" FontSize="12" FontWeight="Bold" Foreground="#475569"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="TxtTotalLivestock" FontSize="26" FontWeight="Bold" Foreground="#1E3259" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="● Status Ternak Terdaftar" FontSize="12" Foreground="AliceBlue" Margin="0,6,0,0" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Total Kandang -->
            <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="18" BorderBrush="#CBD5E1" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" Direction="270" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="TOTAL KANDANG" FontSize="12" FontWeight="Bold" Foreground="#475569"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="TxtTotalCages" FontSize="26" FontWeight="Bold" Foreground="#1E3259" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Fasilitas Aktif" FontSize="12" Foreground="#334155" Margin="0,6,0,0" FontWeight="Medium"/>
                </StackPanel>
            </Border>

            <!-- Card 3: Populasi vs Kapasitas -->
            <Border Grid.Column="4" Background="White" CornerRadius="10" Padding="18" BorderBrush="#CBD5E1" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" Direction="270" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="POPULASI VS KAPASITAS" FontSize="12" FontWeight="Bold" Foreground="#475569"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock x:Name="TxtPopulation" FontSize="26" FontWeight="Bold" Foreground="#1E3259" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Kapasitas Terpakai" FontSize="12" Foreground="#334155" Margin="0,6,0,0" FontWeight="Medium"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Container Tabel Vaksin Jatuh Tempo -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="20" BorderBrush="#CBD5E1" BorderThickness="1" VerticalAlignment="Top">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" Direction="270" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <Border Background="#FEF3C7" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock Text="Jadwal" Foreground="#B45309" FontSize="12" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="Vaksin Jatuh Tempo (7 Hari Ke Depan)" FontSize="16" FontWeight="Bold" Foreground="#1E3259" VerticalAlignment="Center"/>
                </StackPanel>

                <DataGrid x:Name="GridDueVaccinations" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" RowHeight="38" 
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                          HeadersVisibility="Column" MaxHeight="220"
                          Foreground="#0F172A" FontSize="13" FontWeight="Medium">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F1F5F9"/>
                            <Setter Property="Foreground" Value="#1E293B"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#CBD5E1"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,6"/>
                            <Setter Property="Foreground" Value="#0F172A"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tag Sapi" Binding="{Binding Livestock.TagNumber}" Width="*"/>
                        <DataGridTextColumn Header="Jatuh Tempo" Binding="{Binding NextDueDate, StringFormat=dd MMM yyyy}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="TxtNoDue" Text="Tidak ada vaksin jatuh tempo." Foreground="#334155" FontSize="13" FontWeight="Medium" Margin="0,12,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
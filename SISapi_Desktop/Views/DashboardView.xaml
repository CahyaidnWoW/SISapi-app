<UserControl x:Class="SISapi_Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             Background="#F8FAFC"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <!-- Tombol Utama (Navy Blue khas Si-Sapi) -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#1E3259"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#294579"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tombol Sekunder (Outline Clean) -->
        <Style x:Key="OutlineBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="360"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Dashboard Manajemen Penggemukan Sapi" FontSize="24" FontWeight="Bold" Foreground="#1E3259"/>
                    <TextBlock Text="Monitoring performa bobot harian (ADG), stok pakan, dan kesehatan ternak." FontSize="13" Foreground="#475569" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Hanya 1 Tombol Jelas -->
                <Button Content="Ekspor Laporan" Click="BtnOpenExportDialog_Click" 
                        Style="{StaticResource PrimaryBtnStyle}" Height="36" 
                        HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,20">
                <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,10,0" BorderBrush="#CBD5E1" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Total Populasi" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtTotalCattle" Text="0" FontSize="26" FontWeight="Bold" Foreground="#1E293B" Margin="0,6,0,0"/>
                        <TextBlock Text="Ekor sapi aktif" FontSize="11" Foreground="#10B981" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,10,0" BorderBrush="#CBD5E1" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Rata-rata ADG (30 Hari)" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtAvgAdg" Text="0.00 kg" FontSize="26" FontWeight="Bold" Foreground="#2563EB" Margin="0,6,0,0"/>
                        <TextBlock Text="Kenaikan bobot/hari" FontSize="11" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,10,0" BorderBrush="#CBD5E1" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Siap Jual (>= 450kg)" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtReadyToSell" Text="0" FontSize="26" FontWeight="Bold" Foreground="#059669" Margin="0,6,0,0"/>
                        <TextBlock Text="Siap dipasarkan" FontSize="11" Foreground="#10B981" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="16" Margin="0,0,10,0" BorderBrush="#CBD5E1" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Kondisi Kritis / Sakit" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtSickCattle" Text="0" FontSize="26" FontWeight="Bold" Foreground="#DC2626" Margin="0,6,0,0"/>
                        <TextBlock Text="Perlu tindakan medis" FontSize="11" Foreground="#DC2626" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="10" Padding="16" BorderBrush="#CBD5E1" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Pakan Kritis" FontSize="12" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtCriticalFeed" Text="0" FontSize="26" FontWeight="Bold" Foreground="#D97706" Margin="0,6,0,0"/>
                        <TextBlock Text="Jenis pakan ≤ 50 kg" FontSize="11" Foreground="#D97706" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- 2. Card Grafik Pertumbuhan Bobot -->
            <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="18" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.04" Direction="270" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Tren Pertumbuhan Bobot Sapi" FontSize="16" FontWeight="Bold" Foreground="#1E3259" Margin="0,0,0,14"/>

                    <lvc:CartesianChart Grid.Row="1" x:Name="ChartWeightTrend" LegendLocation="Top">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Bulan" x:Name="AxisXMonths" Labels="{Binding MonthLabels}"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Bobot (kg)" MinValue="0" MaxValue="550" Foreground="#2563EB"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>
            </Border>

            <!-- 3. Card Tabel Jadwal Vaksinasi & Penanganan Medis -->
            <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="18" BorderBrush="#CBD5E1" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.04" Direction="270" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Jadwal Vaksinasi &amp; Penanganan Medis (7 Hari Kedepan)" 
                               FontSize="16" FontWeight="Bold" Foreground="#1E3259" Margin="0,0,0,14"/>

                    <DataGrid x:Name="DgUpcomingMedical" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              Background="Transparent" BorderThickness="0" RowHeight="42" 
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                              HeadersVisibility="Column" Foreground="#0F172A" FontSize="13" FontWeight="Medium">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#CBD5E1"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tag Sapi" Binding="{Binding CattleTag}" Width="150"/>
                            <DataGridTextColumn Header="Jenis Tindakan / Vaksin" Binding="{Binding TreatmentType}" Width="*"/>
                            <DataGridTextColumn Header="Tanggal Rencana" Binding="{Binding ScheduledDate, StringFormat=\{0:dd MMM yyyy\}}" Width="180"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>

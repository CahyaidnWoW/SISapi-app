<UserControl x:Class="SISapi_Desktop.Views.FcrReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="850"
             Background="#F8FAFC"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <UserControl.Resources>
        <!-- Style Tombol Utama Modern -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#294579"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1E3259"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#15233E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,25">
            <StackPanel>
                <TextBlock Text="Laporan FCR" FontSize="26" FontWeight="Bold" Foreground="#1E3259"/>
                <TextBlock Text="Hitung dan evaluasi efisiensi pakan (Feed Conversion Ratio) per kandang." FontSize="13" Foreground="#334155" FontWeight="Medium" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Card Filter & Aksi -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="18" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="#000000" Opacity="0.05" Direction="270" ShadowDepth="2"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Pilih Kandang:" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,12,0"/>
                <ComboBox x:Name="CmbCage" Width="200" Height="36" Margin="0,0,12,0"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          VerticalContentAlignment="Center" FontSize="13" Foreground="#0F172A" Padding="8,0"/>
                <Button x:Name="BtnCalculate" Content="Hitung FCR" Click="BtnCalculate_Click" 
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </Border>

        <!-- Pesan Error -->
        <TextBlock x:Name="TxtError" Grid.Row="2" Foreground="#DC2626" FontSize="13" FontWeight="Bold" Visibility="Collapsed" Margin="0,0,0,16"/>

        <!-- Card Hasil Perhitungan FCR -->
        <Border Grid.Row="3" Background="White" Padding="32" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1"
                x:Name="ResultPanel" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Left" MinWidth="420">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" Color="#000000" Opacity="0.05" Direction="270" ShadowDepth="3"/>
            </Border.Effect>
            <StackPanel HorizontalAlignment="Center">
                <Border Background="#F1F5F9" CornerRadius="8" Padding="24,12" Margin="0,0,0,12" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtFcrValue" FontSize="48" FontWeight="Bold" Foreground="#1E3259" HorizontalAlignment="Center"/>
                </Border>
                <TextBlock Text="FEED CONVERSION RATIO" HorizontalAlignment="Center" Foreground="#475569" FontSize="12" FontWeight="Bold" Margin="0,0,0,16"/>

                <Border Height="1" Background="#E2E8F0" Margin="0,0,0,16" HorizontalAlignment="Stretch"/>

                <TextBlock x:Name="TxtTotalFeed" HorizontalAlignment="Center" Foreground="#1E293B" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock x:Name="TxtWeightGain" HorizontalAlignment="Center" Foreground="#1E293B" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>